{
  "name": "thaw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thaw: evidence-based release of merchant reserves. A concept prototype built from public sources; not affiliated with Stripe.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "backtest": "vite-node scripts/backtest.ts",
    "snapshot": "vite-node scripts/snapshot.ts",
    "record": "node scripts/record-demo.mjs --voice none",
    "record:voice": "node scripts/record-demo.mjs",
    "paper": "vite-node scripts/paper.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
